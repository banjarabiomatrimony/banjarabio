  "faqA1": "ಪ್ರೊಫೈಲ್ ಟ್ಯಾಬ್‌ಗೆ ಹೋಗಿ ಮತ್ತು \"ಬಯೋಡೇಟಾ ರಚಿಸಿ\" ಕ್ಲಿಕ್ ಮಾಡಿ ಅಥವಾ ನಿಮ್ಮ ಅಸ್ತಿತ್ವದಲ್ಲಿರುವ ಪ್ರೊಫೈಲ್ ಅನ್ನು ಎಡಿಟ್ ಮಾಡಿ. ನಿಮ್ಮ ವೈಯಕ್ತಿಕ, ಕುಟುಂಬ ಮತ್ತು ವೃತ್ತಿಪರ ವಿವರಗಳನ್ನು ತುಂಬಲು ಬಹು-ಹಂತದ ಫಾರ್ಮ್ ಅನ್ನು ಅನುಸರಿಸಿ.",
  "faqA2": "ಹೌದು, ನಾವು ಗೌಪ್ಯತೆಯನ್ನು ಗಂಭೀರವಾಗಿ ಪರಿಗಣಿಸುತ್ತೇವೆ. ನಿಮ್ಮ ಸಂಪರ್ಕ ವಿವರಗಳನ್ನು ಪರಿಶೀಲಿಸಿದ ಬಳಕೆದಾರರಿಗೆ ಮಾತ್ರ ತೋರಿಸಲಾಗುತ್ತದೆ ಮತ್ತು ನಮ್ಮ ಸಮುದಾಯದ ಸುರಕ್ಷತಾ ಮಾರ್ಗಸೂಚಿಗಳನ್ನು ಗೌರವಿಸುತ್ತದೆ.",
  "faqA3": "ಹೋಮ್ ಸ್ಕ್ರೀನ್‌ನಲ್ಲಿ, ವಯಸ್ಸು, ಸ್ಥಳ, ಶಿಕ್ಷಣ ಮತ್ತು ವೃತ್ತಿಯ ಮೂಲಕ ಪ್ರೊಫೈಲ್‌ಗಳನ್ನು ಕಿರಿದಾಗಿಸಲು \"ಫಿಲ್ಟರ್‌ಗಳು\" ಬಟನ್ ಬಳಸಿ.",
  "faqA4": "ಪ್ರೀಮಿಯಂ ಬಳಕೆದಾರರು ಅನಿಯಮಿತ ಪ್ರೊಫೈಲ್ ವೀಕ್ಷಣೆಗಳು, ಹೊಸ ಬಯೋಡೇಟಾಗಳಿಗೆ ಆರಂಭಿಕ ಪ್ರವೇಶ ಮತ್ತು ಹುಡುಕಾಟ ಫಲಿತಾಂಶಗಳಲ್ಲಿ ವರ್ಧಿತ ಗೋಚರತೆಯನ್ನು ಪಡೆಯುತ್ತಾರೆ.",
  "faqA5": "ನಮ್ಮ ಸಿಸ್ಟಂನಿಂದ ನಿಮ್ಮ ಪ್ರೊಫೈಲ್ ಮತ್ತು ಡೇಟಾವನ್ನು ಶಾಶ್ವತವಾಗಿ ತೆಗೆದುಹಾಕಲು ನನ್ನ ಪ್ರೊಫೈಲ್ > ಕಾನೂನು ಮತ್ತು ಮಾಹಿತಿ > ಖಾತೆ ಅಳಿಸುವಿಕೆಗೆ ಹೋಗಿ.",
  "faqQ1": "ಬಯೋಡೇಟಾವನ್ನು ನಾನು ಹೇಗೆ ರಚಿಸುವುದು?",
