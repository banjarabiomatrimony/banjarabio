{
  "outputDirectory": "web",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/privacy-policy",
      "destination": "/privacy-policy.html"
    },
    {
      "source": "/terms-and-conditions",
      "destination": "/terms-and-conditions.html"
    },
    {
      "source": "/about-us",
      "destination": "/about-us.html"
    },
    {
      "source": "/contact-us",
      "destination": "/contact-us.html"
    },
    {
      "source": "/melava",
      "destination": "/melava.html"
    },
    {
      "source": "/gotra-guide",
      "destination": "/gotra-guide.html"
    },
    {
      "source": "/trust-and-verification",
      "destination": "/trust-and-verification.html"
    },
    {
      "source": "/biodata-maker",
      "destination": "/biodata-maker.html"
    },
    {
      "source": "/success-stories",
      "destination": "/success-stories.html"
    },
    {
      "source": "/faq",
      "destination": "/faq.html"
    },
    {
      "source": "/p/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/profile/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/invite/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
