# ─── Root-level debris prevention ─────────────────────────────────────────────
# Prevent test logs, audit dumps, and scratch scripts from polluting root
*.log
*.txt
!app-ads.txt
!README.md
!RELEASE_NOTES.md
*.original.md
*.py
*.sh
!scripts/*.sh

# ─── IntelliJ / Android Studio ────────────────────────────────────────────────
*.iml
*.ipr
*.iws
.idea/

# ─── Flutter / Dart / Pub ─────────────────────────────────────────────────────
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# ─── Symbolication & Obfuscation ──────────────────────────────────────────────
app.*.symbols
app.*.map.json

# ─── Test Output & Failures ───────────────────────────────────────────────────
test_result*.json
test/golden/failures/

